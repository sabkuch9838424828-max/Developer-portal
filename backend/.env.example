# Application
APP_ENV=development
SECRET_KEY=nexora-secret-token-key-2026-6b8f72a4c9e10283f51a8d0e74b92c63f10928a7e4b5

# Database (PostgreSQL with smart auto-fallback to SQLite)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nexora

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Configuration (Supports Gemini and Grok; offline NLP fallback active if keys omitted)
AI_PROVIDER=gemini
AI_FEATURES_ENABLED=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

GROK_API_KEY=
GROK_MODEL=grok-beta

AI_TIMEOUT=60
AI_MAX_RETRIES=3

# Matching
MATCH_THRESHOLD=75

# File storage
STORAGE_BACKEND=local
MAX_UPLOAD_SIZE_MB=15

# Email (Optional)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
