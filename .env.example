# ==============================================================================
# NEXORA MASTER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Project Details
PROJECT_NAME="NEXORA"
VERSION="1.0.0"

# Application Security
SECRET_KEY="nexora-super-secret-production-key-2026-secure-token-hash"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Default: SQLite out-of-the-box (zero configuration required)
DATABASE_URL="sqlite:///./nexora.db"
# Production PostgreSQL (uncomment when deploying to PostgreSQL with pgvector):
# DATABASE_URL="postgresql://nexora_user:password@localhost:5432/nexora_db"

# ==============================================================================
# AI PROVIDER CONFIGURATION (Centralized & Provider-Independent)
# Select: "gemini" OR "grok"
# ==============================================================================
AI_PROVIDER="gemini"

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-pro"

# xAI Grok API
GROK_API_KEY=""
GROK_MODEL="grok-beta"

# AI Execution Engine Parameters
AI_TIMEOUT=60
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.1
AI_FEATURES_ENABLED=true

# ==============================================================================
# DETERMINISTIC HYBRID MATCHING ENGINE PARAMETERS
# Default weights: Mandatory 40%, Preferred 20%, Projects 20%, Exp 10%, Avail 10%
# ==============================================================================
MATCH_THRESHOLD=75
WEIGHT_MANDATORY_SKILLS=0.40
WEIGHT_PREFERRED_SKILLS=0.20
WEIGHT_RELEVANT_PROJECTS=0.20
WEIGHT_EXPERIENCE=0.10
WEIGHT_AVAILABILITY_PREFERENCE=0.10

# Document Intelligence & File Storage
STORAGE_DIR="./storage/uploads"
MAX_FILE_SIZE_MB=15

# Frontend Environment Variable
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
